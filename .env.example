# Copy to .env and fill in real values. Never commit .env.
ENV=dev

# Postgres
POSTGRES_USER=w4f
POSTGRES_PASSWORD=change-me
POSTGRES_DB=w4f
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://w4f:change-me@localhost:5432/w4f

# Test database (used by pytest)
TEST_DATABASE_URL=postgresql+psycopg://w4f:change-me@localhost:5432/w4f_test

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS_MOQADDEM=30
REFRESH_TOKEN_EXPIRE_DAYS_OTHER=7

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=w4f
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=w4f-media
MINIO_SECURE=false

# CORS
CORS_ORIGINS=http://localhost:5173

# Firebase (optional; sync service falls back to no-op when unset)
FCM_CREDENTIALS_JSON=
